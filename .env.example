# Server
PORT=8080
NODE_ENV=development

# Required: use a unique, long random secret; never commit real values
JWT_SECRET=replace_with_a_long_random_secret

# Required: use the Connectify/Mini Instagram database only
MONGODB_URL=mongodb+srv://<database-user>:<password>@<your-cluster>/<database-name>?retryWrites=true&w=majority

# Optional: comma-separated frontend origin(s), no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# Optional for image uploads; all three must be set together
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
